{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension: Run",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--trace-deprecation"
      ],
      "outFiles": [
        "${workspaceFolder}/lspd-plugin/dist/**/*.js"
      ]
    }
  ]
}
